{
  "name": "mnemosyne",
  "version": "0.1.0",
  "private": true,
  "description": "AI 时代的云笔记 —— 让 AI 替你维护知识库，思考永不丢失，永远属于你自己",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "quality-gate": "npm run lint && npm run typecheck && npm test",
    "build:worker": "opennextjs-cloudflare build",
    "predeploy": "node -e \"const fs=require('fs');const p='.open-next/server-functions/default/node_modules/onnxruntime-node';if(fs.existsSync(p)){fs.rmSync(p,{recursive:true,force:true});console.log('removed onnxruntime-node from server bundle')}\"",
    "deploy": "opennextjs-cloudflare build && npm run predeploy && wrangler deploy",
    "preview": "opennextjs-cloudflare build && wrangler dev"
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.66",
    "ai": "^3.4.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^1.1.7",
    "idb-keyval": "^6.2.1",
    "nanoid": "^5.0.7",
    "next": "^15.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1",
    "ts-fsrs": "^4.5.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.9",
    "fake-indexeddb": "^6.0.0",
    "ignore-loader": "^0.1.2",
    "jsdom": "^24.1.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "wrangler": "^4.86.0"
  }
}
