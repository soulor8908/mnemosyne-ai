# Mnemosyne 自托管环境变量
# 用法：cp .env.example .env，然后填入真实值
# 注意：本文件不含任何真实密钥，可安全提交到仓库

# ── 访问令牌 ──────────────────────────────────────────────
# API / 同步通道访问令牌（必填）。零信任多用户模式下，此令牌仅用于
# 兼容遗留共享访问；真正的用户会话由助记词挑战应答派生。
SYNC_TOKEN=your-secure-token-here

# ── 本地存储（替代 Cloudflare KV） ────────────────────────
# Redis 连接串。容器内通过 docker 网络走服务名 redis。
# 用于会话、challenge、审计日志等需要服务端共享状态的键。
REDIS_URL=redis://redis:6379

# ── 重排服务 ─────────────────────────────────────────────
# Cross-Encoder 重排服务地址（services/rerank/ 提供的 FastAPI 服务）。
# 容器内走服务名 rerank。
RERANK_URL=http://rerank:8001

# ── LLM 配置（BYOK） ─────────────────────────────────────
# 至少配一个即可，按 AI_PROVIDER 选择默认 provider。
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# 默认 AI provider：openai | deepseek | glm
AI_PROVIDER=deepseek

# ── 嵌入模式 ─────────────────────────────────────────────
# local  ：384 维，浏览器内用 @xenova/transformers 推理，无需外部服务（本地部署默认）
# cloud  ：768 维，走 Cloudflare Workers AI（bge-base-en-v1.5），仅 Cloudflare 部署可用
# 自托管场景必须设为 local，Workers AI 不可用。
EMBEDDING_MODE=local

# ── 应用 URL（可选） ─────────────────────────────────────
APP_URL=http://localhost:3000
