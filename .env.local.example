# Mnemosyne 环境变量示例
# 复制为 .env.local 并填入真实值

# 平台 Trial 模式的 AI provider keys（可选，BYOK 用户不需要）
DEEPSEEK_API_KEY=
GLM_API_KEY=

# 注意：MASTER_KEY 不在 .env 中配置。
# 它由浏览器端生成 12 词 BIP39 助记词并派生，仅存于用户设备内存。
# 详见 docs/TECHNICAL_DESIGN.md 7.1 节。

# 默认 AI provider
AI_PROVIDER=deepseek

# 应用 URL
APP_URL=http://localhost:3000
